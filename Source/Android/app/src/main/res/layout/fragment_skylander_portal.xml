<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#D9101014"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tab_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Meine Sammlung"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_summon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Beschwören"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_maxed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Ultimative"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/glyph_mode"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_ps_triangle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:alpha="0.8" />

        <TextView
            android:id="@+id/text_mode_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_shoulder_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingTop="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_ps_square"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal leeren"
            android:textSize="11sp"
            android:alpha="0.75" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid_figures"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/text_element_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_shoulder_button"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="6dp"
            android:text="L1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/scroll_elements"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/row_elements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/text_element_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_shoulder_button"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:text="R1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_shoulder_button"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="5dp"
            android:text="R2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_filter_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_variants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_shoulder_button"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="5dp"
            android:text="Share"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_filter_variants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:alpha="0.85" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="3dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/row_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>
</LinearLayout>
