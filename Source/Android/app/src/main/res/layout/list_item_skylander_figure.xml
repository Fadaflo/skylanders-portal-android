<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_margin="3dp"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp">

        <ImageView
            android:id="@+id/image_figure"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/image_element"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|end"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/image_swap_part"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:padding="2dp"
            android:background="@drawable/sky_card_idle"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_figure_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFF5F8FD"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_figure_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFB7CDE0"
        android:textSize="11sp" />
</LinearLayout>
